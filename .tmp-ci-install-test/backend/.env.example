# =============================================================================
# SMC SuperFIB — TanStack Start Backend (Phase 0)
# Template. Copy to .env.local and replace placeholder values.
# .env.local is gitignored (*.local). NEVER commit real credentials.
# =============================================================================

# --- Supabase PostgreSQL connection (server-side ingest uses this) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...[ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=eyJ...[SERVICE-ROLE-KEY]

# --- EA ingest auth (mirrors WordPress SMC_SF_EA_API_KEY) ---
# Header accepted: X-EA-API-Key (also X-API-KEY)
EA_API_KEY=ea-secure-key-change-in-production

# --- JWT session signing secret (for dashboard auth, Phase 6) ---
JWT_SECRET=super-secret-change-in-production

# --- Shadow-mode WordPress source (Phase 3) ---
WORDPRESS_API_URL=https://trader.stokvelsociety.co.za/wp-json/sniper/v1
WORDPRESS_API_KEY=wp-api-key-for-shadow-sync

# --- Nitro build preset override (leave empty for local Node dev) ---
# Set to "cloudflare-module" for production Workers build.
NITRO_PRESET=
