{
  "name": "smc-superfib-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nitro dev",
    "build": "nitro build",
    "preview": "nitro preview",
    "start": "node .output/server/index.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "typecheck": "node --import tsx/esm node_modules/typescript/lib/tsc.js --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "sync:shadow": "node --import tsx/esm scripts/shadow-sync.ts",
    "validate:shadow": "node --import tsx/esm scripts/validate-shadow.ts",
    "test:integration": "node --import tsx/esm node_modules/vitest/vitest.mjs run tests/integration"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "h3": "^1.13.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "drizzle-kit": "^0.24.0",
    "eslint": "^9.39.5",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
